<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TradingJournal.Core\TradingJournal.Core.csproj" />
    <ProjectReference Include="..\TradingJournal.Data\TradingJournal.Data.csproj" />
    <ProjectReference Include="..\TradingJournal.Services\TradingJournal.Services.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>EdgeBook</AssemblyTitle>
    <!-- Bilgisayarında kurulu DevExpress sürümü (Visual Studio > Extensions > DevExpress > About). -->
    <DevExpressVersion>26.1.5</DevExpressVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms projelerinde System.IO otomatik eklenmiyor (File, FileStream, MemoryStream için). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevExpress kurulumu "DevExpress XX.X Local" NuGet kaynağını ekler; paket oradan gelir. -->
    <PackageReference Include="DevExpress.Win.Design" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Win.Charts" Version="$(DevExpressVersion)" />
  </ItemGroup>

</Project>
