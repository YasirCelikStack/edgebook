<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TradingJournal.Core\TradingJournal.Core.csproj" />
    <ProjectReference Include="..\TradingJournal.Data\TradingJournal.Data.csproj" />
    <ProjectReference Include="..\TradingJournal.Services\TradingJournal.Services.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>EdgeBook</AssemblyTitle>
    <!-- Exe adı: EdgeBook.exe (kurulum paketi ve kısayollar bu adı kullanır). -->
    <AssemblyName>EdgeBook</AssemblyName>
    <Product>EdgeBook</Product>
    <Company>Yasir Celik</Company>
    <!-- Sürüm: yayın betiği (release.ps1) bunu -p:Version=... ile ezer. -->
    <Version>1.0.5</Version>
    <!-- Exe simgesi (Masaüstü, Başlat menüsü, Dosya Gezgini). -->
    <ApplicationIcon>Assets\edgebook.ico</ApplicationIcon>
    <!-- Bilgisayarında kurulu DevExpress sürümü (Visual Studio > Extensions > DevExpress > About). -->
    <DevExpressVersion>26.1.5</DevExpressVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms projelerinde System.IO otomatik eklenmiyor (File, FileStream, MemoryStream için). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pencere simgesi ve kenar çubuğu logosu exe'ye gömülür (Helpers/AppIcon.cs). -->
    <EmbeddedResource Include="Assets\edgebook.ico" LogicalName="EdgeBook.Icon" />
    <EmbeddedResource Include="Assets\logo-96.png" LogicalName="EdgeBook.Logo" />
  </ItemGroup>

  <ItemGroup>
    <!-- Geliştirici ayarları (Chart Vault bağlantısı, ileride yapay zeka anahtarı). Dosya varsa exe'nin yanına kopyalanır. -->
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevExpress kurulumu "DevExpress XX.X Local" NuGet kaynağını ekler; paket oradan gelir. -->
    <PackageReference Include="DevExpress.Win.Design" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Win.Charts" Version="$(DevExpressVersion)" />
    <PackageReference Include="DevExpress.Win.PivotGrid" Version="$(DevExpressVersion)" />
    <!-- Kurulum dosyası ve GitHub Releases'tan otomatik güncelleme. -->
    <PackageReference Include="Velopack" Version="*" />
  </ItemGroup>

</Project>
