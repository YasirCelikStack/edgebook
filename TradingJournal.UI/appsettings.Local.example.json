{
  // Bu dosyanın bir kopyasını "appsettings.Local.json" adıyla aynı klasöre oluştur ve değerleri doldur.
  // appsettings.Local.json .gitignore'dadır, GitHub'a yüklenmez.

  "ChartVault": {
    // Chart Vault'un Supabase proje adresi: Supabase > Project Settings > API > Project URL
    // (Chart Vault'un .env.local dosyasında NEXT_PUBLIC_SUPABASE_URL)
    "SupabaseUrl": "https://BURAYA.supabase.co",

    // Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
    // (Chart Vault'un .env.local dosyasında NEXT_PUBLIC_SUPABASE_ANON_KEY). Secret key DEĞİL!
    "PublishableKey": "sb_publishable_BURAYA",

    // İSTEĞE BAĞLI. Chart Vault sitesinin adresi; yazılmazsa https://chart-vault-mu.vercel.app kullanılır.
    // Journal işlemlerinin grafik görselleri buradan indirilir (/api/journal/shots).
    "SiteUrl": "https://chart-vault-mu.vercel.app"
  },

  "Ai": {
    // İSTEĞE BAĞLI. Kullanıcılar kendi Gemini anahtarını uygulamadaki "Anahtar ayarla" ile girer.
    // Buraya yazılan anahtar sadece kullanıcı kendi anahtarını girmediyse kullanılır (ör. demo için).
    // Anahtar: https://aistudio.google.com/apikey
    "GeminiApiKey": "",

    // Boş bırakılırsa "gemini-3.6-flash" kullanılır; bulunamazsa en güncel Flash modeli otomatik seçilir.
    "GeminiModel": ""
  }
}
